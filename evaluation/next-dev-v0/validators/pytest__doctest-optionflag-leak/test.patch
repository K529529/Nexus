+            def second():
+                '''
+                >>> {second_example}
+                {second_output}
+                '''
+            """
+        )
+        args = ["--doctest-modules"]
+        if continue_on_failure:
+            args.append("--doctest-continue-on-failure")
+        result = pytester.runpytest(*args)
+        result.assert_outcomes(failed=2 - passed, passed=passed)
