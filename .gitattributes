# 这样仓库里这些源码和文档会统一保存成 LF，Windows、Linux、Codex 之间协作会更稳定。
* text=auto
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Frozen evaluation identities hash exact asset bytes across Windows/Linux checkouts.
evaluation/next-dev-v0/** -text whitespace=cr-at-eol
# Upstream problem statements and unified-diff context retain their original whitespace.
evaluation/next-dev-v0/cases/*/task.md -whitespace
evaluation/next-dev-v0/validators/*/test.patch -whitespace
